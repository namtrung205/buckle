# Cloudflare Tunnel Configuration
# Get your token from the Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Frontend Configuration (Build-time)
# This will be used by Vite during the Docker build process.
# If you are using Nginx proxy (as configured in docker-compose), 
# you can set this to your public domain.
VITE_BACKEND_SERVER=https://your-app.example.com

# Backend Configuration
# Internal port is 8000. Host port is configurable.
ENVIRONMENT=production
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=buckle_db

# Host Port Mapping (Avoid conflicts with other projects)
FRONTEND_PORT=8180
BACKEND_PORT=8101
# Note: MongoDB is not exposed to the host by default to prevent conflicts.
